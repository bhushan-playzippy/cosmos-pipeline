# Copy this file to ".env" and fill in your keys. Never share or commit .env.

# Free: https://aistudio.google.com/apikey  (sign in with the Google account that has your Gemini subscription)
GEMINI_API_KEY=

# Free: https://pixabay.com/api/docs/  (stock video; your key is shown on that page once logged in)
PIXABAY_API_KEY=

# Pexels (new key issuance paused since Oct 2026; keep if you already have one)
PEXELS_API_KEY=

# Only needed when Instagram auto-posting is on (README step 6)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Channel 2 (clips) — see docs/MULTI_CHANNEL.md
# Its own Gemini key (a key from a second Google account/project), so it can't use up channel 1's free quota.
GEMINI_API_KEY_CLIPS=
# Only for CI/servers: contents of credentials/clips/youtube_token.json (locally the file is used instead).
# YOUTUBE_TOKEN_JSON_CLIPS=
